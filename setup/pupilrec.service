# Run the recorder as a service so the iPad can reach it after a reboot
# without anyone logging in.
#   sudo cp setup/pupilrec.service /etc/systemd/system/
#   sudo systemctl enable --now pupilrec
[Unit]
Description=Pupil Core recording front-end
After=network-online.target
Wants=network-online.target
# The restart rate-limit below bounds Restart= in [Service], but the two keys
# themselves belong in [Unit]: systemd ignores them under [Service].
StartLimitIntervalSec=120
StartLimitBurst=12

[Service]
Type=simple
User=zsolt
# plugdev carries the raw USB access granted by 70-pupil-cams.rules.  The
# uaccess tag in that file only covers a local desktop login, which a service
# started at boot does not have -- hence the group.
SupplementaryGroups=plugdev
WorkingDirectory=/home/zsolt/aimotive
ExecStart=/home/zsolt/aimotive/.venv/bin/python /home/zsolt/aimotive/run.py

# The recorder can freeze in a way it cannot detect or recover from itself:
# pyuvc does its USB work with the GIL held, so a camera wedged inside libuvc
# stops every thread in the process -- the HTTP server and signal delivery
# included, which is why SIGTERM does not land on a frozen recorder.  run.py
# pings systemd while it can still run Python; when the pings stop, systemd
# kills and restarts it.  NotifyAccess is what lets those pings through: it
# defaults to none for a Type=simple service, and they would be dropped.
#
# 20s is four missed pings.  Shorter is tempting, but a healthy camera open can
# legitimately hold the GIL for up to FIRST_FRAME_TIMEOUT (4s) and they are
# serialised, so a slow start with four cameras must not be mistaken for a
# freeze.  Long enough not to fire on a bad day, short enough that a freeze
# costs seconds rather than waiting for someone to notice.
NotifyAccess=main
WatchdogSec=20
# run.py exits non-zero when it finds no cameras, so at boot this keeps retrying
# while USB enumeration finishes instead of giving up after the default 5 tries.
# A watchdog timeout counts as a failure here, so it restarts the same way.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
