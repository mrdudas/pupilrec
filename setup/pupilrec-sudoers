# Lets the recorder's web UI restart its own services and power-cycle the sensor
# board, without granting anything else.  Installed to /etc/sudoers.d/pupilrec.
zsolt ALL=(root) NOPASSWD: /usr/local/sbin/pupilrec-recover sensors, /usr/local/sbin/pupilrec-recover server, /usr/local/sbin/pupilrec-recover board
